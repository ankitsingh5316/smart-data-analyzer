PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_data_analyzer

JWT_SECRET=your_secret
JWT_EXPIRES_IN=7d

# Optional. When SMTP_HOST is empty, development mode returns the reset link in the API response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Data Analyzer <noreply@localhost>
