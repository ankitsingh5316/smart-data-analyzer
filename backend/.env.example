PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# Use postgres with DATABASE_URL for the hosted API. Local development stays on mysql.
DB_CLIENT=mysql
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_data_analyzer
DB_SSL=false
DB_SSL_CA=

JWT_SECRET=your_secret
JWT_EXPIRES_IN=7d

# Optional. When SMTP_HOST is empty, development mode returns the code in the API response.
# Set EXPOSE_AUTH_CODES=true only when a hosted site has no email server yet.
EXPOSE_AUTH_CODES=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Data Analyzer <noreply@localhost>
